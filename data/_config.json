{
    "$config": [
        { "serializer": "json", "layout": "index", "dest": "docs" }
    ],
    "$static": {
        "include": [ "assets/*" ]
    },
    "base-products": {
        "$emit": []
    },
    "job-histories": {
        "current": {
            "$filter": [
                { "field": "to", "op": "eq", "value": "Present" }
            ]
        }
    },
    "activities": {
        "${year}": {
            "$derive": { "field": "from", "pattern": "^(\\d{4}).*" },
            "$filter": [
                { "field": "from", "op": "contains", "value": "{year}" }
            ]
        }
    }
}
